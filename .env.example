# Absolute origin of the deployed site, no trailing slash.
# Everything canonical depends on it: <link rel="canonical">, the hreflang
# alternates, the Open Graph URLs, the sitemap and the JSON-LD. Unset, it falls
# back to http://localhost:3000, so it MUST be set in production.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com


# ── Lead database ───────────────────────────────────────────────────────────
# This site's OWN Supabase project. It is not shared with any other website,
# and it must not be pointed at one: the schema in
# supabase/migrations/001_create_leads.sql is this project's alone.
#
# Set up, in order:
#   1. create a new Supabase project
#   2. run supabase/migrations/001_create_leads.sql in its SQL editor
#   3. copy the three values below from Project Settings → API
#
# The migration enables row level security with NO policy and revokes the
# default grants, so neither the anon role nor an authenticated role can read
# a lead. Every access goes through the service role, from the server. That is
# deliberate — see the comments at the top of the migration.
NEXT_PUBLIC_SUPABASE_URL=
# Used only for CRM sign-in, never to read or write a lead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. No NEXT_PUBLIC_ prefix, and lib/db/supabase.ts is marked
# `server-only`, so importing it from a client component is a build error
# rather than a key in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# While these are unset the quotation form still validates and still tells the
# visitor plainly that nothing was sent. It never reports a success that did
# not happen.


# ── Lead email ──────────────────────────────────────────────────────────────
# This site's own Resend account and its own verified sending domain. Not
# shared with any other website.
RESEND_API_KEY=
# Must be on a domain verified in THIS Resend account.
LEAD_FROM_EMAIL=Private Transfer Across Italy <quotes@your-domain.com>
# Where a new quotation request is announced.
LEAD_ADMIN_EMAIL=
# Optional. Defaults to LEAD_ADMIN_EMAIL when unset.
LEAD_REPLY_TO_EMAIL=

# With these unset a lead is still saved; both emails are recorded on the lead
# as "skipped" rather than silently not happening.


# ── Quotation form rate limiting ────────────────────────────────────────────
# Optional. Counted in the database rather than in process memory, so the
# limit is exact however many instances are running. Keyed on the submitted
# email address, not the IP: an IP is shared by a hotel, an office or a whole
# mobile carrier, and limiting on it punishes the wrong people.
# QUOTE_RATE_LIMIT=10
# QUOTE_RATE_WINDOW_MS=600000


# ── CRM access ──────────────────────────────────────────────────────────────
# Who may use the CRM at /crm. A comma-separated list of email addresses.
#
# Being able to sign in to the Supabase project is NOT the same as being
# allowed into the CRM: a project's sign-up endpoint can be open, so a session
# gets a second test against this list. An address that authenticates but is
# not listed here is signed straight back out.
#
# An empty or unset list denies everyone. That is deliberate — a misconfigured
# deployment should lock the CRM, not open it.
CRM_ALLOWED_EMAILS=

# Create the CRM user in the Supabase dashboard (Authentication → Users →
# Add user), then put that address here. Do not enable public sign-ups on the
# project.
